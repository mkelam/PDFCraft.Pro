# Production Environment Configuration - pdflab.pro
# Copy this file to .env and update with your production values
# Critical for OCR Overlay system deployment

# Server Configuration
NODE_ENV=production
PORT=3001
HOST=0.0.0.0

# Database Configuration (MySQL)
DB_HOST=your-mysql-host.hostinger.com
DB_PORT=3306
DB_NAME=pdflab_pro
DB_USER=pdflab_user
DB_PASSWORD=your-secure-database-password
DB_SSL=true
MYSQL_ROOT_PASSWORD=your-mysql-root-password

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_DB=0

# JWT Configuration
JWT_SECRET=your-very-long-and-secure-jwt-secret-at-least-32-characters
JWT_EXPIRES_IN=7d

# NextAuth.js Configuration
NEXTAUTH_SECRET=your-production-nextauth-secret-at-least-32-characters
NEXTAUTH_URL=https://pdflab.pro

# Social Authentication Providers (Production)
GOOGLE_CLIENT_ID=your-production-google-client-id
GOOGLE_CLIENT_SECRET=your-production-google-client-secret
FACEBOOK_CLIENT_ID=your-production-facebook-app-id
FACEBOOK_CLIENT_SECRET=your-production-facebook-app-secret
LINKEDIN_CLIENT_ID=your-production-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-production-linkedin-client-secret

# PayFast Payment Configuration (South African Payment Gateway)
PAYFAST_MERCHANT_ID=your-production-payfast-merchant-id
PAYFAST_MERCHANT_KEY=your-production-payfast-merchant-key
PAYFAST_PASSPHRASE=your-production-payfast-passphrase
PAYFAST_SANDBOX=false

# Stripe Payment Configuration (Legacy - Remove if using PayFast only)
# STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
# STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# CORS Configuration
CORS_ORIGINS=https://pdflab.pro,https://www.pdflab.pro

# File Upload Configuration
UPLOAD_DIR=/app/uploads
TEMP_DIR=/app/temp
MAX_FILE_SIZE=104857600

# Processing Configuration
CONCURRENT_JOBS=5
JOB_TIMEOUT=300000
LIBREOFFICE_PATH=/usr/bin/libreoffice

# OCR Overlay Configuration
TESSERACT_PATH=/usr/bin/tesseract
IMAGE_PROCESSING_QUALITY=85
DEFAULT_DPI=300
MAX_DPI=600

# Monitoring & Logging
LOG_LEVEL=info
LOG_DIR=/app/logs
ENABLE_METRICS=true

# Security Configuration
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Email Configuration (for notifications)
SMTP_HOST=your-smtp-host
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
FROM_EMAIL=noreply@pdflab.pro

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# Performance Configuration
COMPRESSION_LEVEL=6
KEEP_ALIVE_TIMEOUT=65000
HEADERS_TIMEOUT=66000

# Grafana Configuration
GRAFANA_PASSWORD=your-grafana-admin-password

# Domain Configuration
DOMAIN=pdflab.pro
SSL_EMAIL=admin@pdflab.pro

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=10000

# Cache Configuration
CACHE_TTL=3600000
MAX_CACHE_SIZE=524288000

# Queue Configuration
QUEUE_CLEANUP_INTERVAL=1800000
FAILED_JOB_RETENTION=86400000

# Development/Debug (set to false in production)
DEBUG_MODE=false
ENABLE_SWAGGER=false
ENABLE_PROFILING=false

# Third-party API Keys (if needed)
OPENAI_API_KEY=your-openai-api-key-if-needed
GOOGLE_CLOUD_API_KEY=your-google-cloud-key-if-needed

# Sentry Error Tracking (optional)
SENTRY_DSN=your-sentry-dsn-url

# Analytics Configuration (optional)
GOOGLE_ANALYTICS_ID=your-ga-id
MIXPANEL_TOKEN=your-mixpanel-token

# CDN Configuration (optional)
CDN_URL=https://cdn.pdflab.pro
STATIC_ASSETS_URL=https://assets.pdflab.pro