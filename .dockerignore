# ============================================
# PDFCraft.Pro Root .dockerignore
# For frontend builds (Dockerfile.frontend)
# ============================================

# Dependencies (reinstalled in container)
node_modules/
backend/node_modules/
BMAD-METHOD/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Backend files (not needed for frontend build)
backend/
!backend/.env.example

# Build outputs (created in container)
.next/
out/
dist/
build/
*.tsbuildinfo

# Environment files (passed as build args)
.env*
!.env.example

# Development files
.git/
.gitignore
.gitattributes
.github/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.editorconfig

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Testing
coverage/
.nyc_output/
*.test.ts
*.test.js
*.spec.ts
*.spec.js
__tests__/
jest.config.*
playwright.config.*
e2e/

# Documentation
docs/
Docs/
*.md
!README.md
*.txt
CHANGELOG.md
CONTRIBUTING.md
LICENSE

# Logs and runtime data
logs/
*.log
pids/
*.pid

# Temporary and upload files
temp/
tmp/
uploads/
*.tmp
*.temp
test-*
demo-*
example-*

# Database files
*.sqlite
*.db
*.sqlite3
data/

# Docker files
Dockerfile
Dockerfile.*
docker-compose*.yml
.dockerignore
*.dockerfile
nginx/

# Development scripts
.bmad-core/
BMAD-METHOD/
scripts/
*.bat
*.sh

# Certificates and secrets
*.pem
*.key
*.cert
*.crt
ssl/
secrets/

# CI/CD
.travis.yml
.gitlab-ci.yml
.circleci/
azure-pipelines.yml

# Backup files
*.bak
*.backup
backup/

# Large binary files
*.pdf
*.pptx
*.docx
*.xlsx
*.zip
*.tar
*.gz