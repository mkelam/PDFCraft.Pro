# PDFCraft.Pro Docker Ignore File
# Excludes files and directories from Docker build context

# Node modules (will be installed in container)
node_modules/
backend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Development files
.git/
.gitignore
README.md
.env
.env.local
.env.development
.env.test

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Development and testing
backend/test-*
backend/uploads/
backend/temp/
backend/logs/
backend/dist/
backend/coverage/
test-output/
*.test.ts
*.spec.ts
__tests__/

# Documentation and assets
docs/
Docs/
*.md
*.txt
!package.json
!package-lock.json

# Build outputs (Next.js)
.next/
out/
build/

# Temporary files
*.tmp
*.temp
temp/
tmp/

# Database files
*.sqlite
*.db

# Log files
*.log
logs/

# Docker files
Dockerfile
docker-compose*.yml
.dockerignore

# Development scripts (keep scripts/ for build validation)
.bmad-core/
BMAD-METHOD/

# Test and demo files
test-*
demo-*
example-*
sample-*

# Documentation files
CHANGELOG.md
CONTRIBUTING.md
LICENSE
*.md
!README.md

# Backup files
*.bak
*.backup
backup/

# Certificates and keys (should be mounted as volumes)
*.pem
*.key
*.cert
ssl/

# Environment specific files
.env.*
!.env.production