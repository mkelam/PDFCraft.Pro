# PDFCraft.Pro Docker Environment Variables
# Copy this file to .env.docker and fill in your values

# ===== SECURITY ======
# Generate a secure random string for JWT secret
# You can use: openssl rand -base64 64
JWT_SECRET=your-very-secure-jwt-secret-key-change-this-in-production

# ===== EMAIL CONFIGURATION =====
# Hostinger SMTP Settings
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=registration@pdflab.pro
SMTP_PASSWORD=your-email-password
SMTP_FROM=PDFLab.Pro <registration@pdflab.pro>

# ===== URLS =====
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3016

# ===== CLOUDCONVERT (Optional - for enhanced PDF processing) =====
CLOUDCONVERT_API_KEY=your-cloudconvert-api-key-here
CLOUDCONVERT_SANDBOX=false

# ===== PAYFAST (South African Payment Gateway - Optional) =====
PAYFAST_MERCHANT_ID=your-merchant-id
PAYFAST_MERCHANT_KEY=your-merchant-key
PAYFAST_PASSPHRASE=your-passphrase
PAYFAST_SANDBOX=true

# ===== DATABASE (Optional - Docker uses SQLite by default) =====
# Only needed if using MySQL instead of SQLite
# MYSQL_ROOT_PASSWORD=secure-root-password
# MYSQL_PASSWORD=secure-user-password
