# Environment Variables for PDFCraft.Pro
# Copy this file to .env.local and fill in your actual values

# =============================================================================
# NextAuth.js Configuration
# =============================================================================

# NextAuth Secret - Generate a random 32-character string
# You can generate one using: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-key-here

# NextAuth URL - Your app's URL
NEXTAUTH_URL=http://localhost:3000

# =============================================================================
# Social Authentication Providers
# =============================================================================

# Google OAuth
# Get from: https://console.developers.google.com/
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Facebook OAuth
# Get from: https://developers.facebook.com/
FACEBOOK_CLIENT_ID=your-facebook-app-id
FACEBOOK_CLIENT_SECRET=your-facebook-app-secret

# LinkedIn OAuth
# Get from: https://www.linkedin.com/developers/
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# =============================================================================
# PayFast Payment Integration (South African Payment Gateway)
# =============================================================================

# PayFast Merchant Details
# Get from: https://www.payfast.co.za/
PAYFAST_MERCHANT_ID=your-payfast-merchant-id
PAYFAST_MERCHANT_KEY=your-payfast-merchant-key
PAYFAST_PASSPHRASE=your-payfast-passphrase
PAYFAST_SANDBOX=true

# =============================================================================
# Backend API Configuration
# =============================================================================

# API Base URL for frontend to connect to backend
NEXT_PUBLIC_API_URL=http://localhost:3010

# =============================================================================
# Development/Production Mode
# =============================================================================

# Node Environment
NODE_ENV=development

# =============================================================================
# Optional: Analytics and Monitoring
# =============================================================================

# Vercel Analytics (if using Vercel)
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=your-vercel-analytics-id

# =============================================================================
# IMPORTANT NOTES:
# =============================================================================
#
# 1. NEVER commit this file with real credentials to version control
# 2. Create .env.local with your actual values
# 3. For production, set these in your hosting platform's environment variables
# 4. Test social auth providers in development mode first
# 5. PayFast: Start with sandbox mode, then switch to production