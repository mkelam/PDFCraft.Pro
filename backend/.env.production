# Production Environment Configuration
NODE_ENV=production
PORT=3001

# Database Configuration (Hostinger MySQL)
DB_HOST=your-hostinger-mysql-host
DB_NAME=pdfcraft_db
DB_USER=your-mysql-user
DB_PASSWORD=your-mysql-password
DB_PORT=3306

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=your-super-secure-jwt-secret-min-32-chars
JWT_EXPIRES_IN=24h

# File Upload Configuration
MAX_FILE_SIZE=104857600
UPLOAD_DIR=/var/www/pdfcraft/uploads
TEMP_DIR=/var/www/pdfcraft/temp

# LibreOffice Configuration
LIBREOFFICE_PATH=/usr/bin/libreoffice
LIBREOFFICE_AVAILABLE=true

# PayFast Configuration (South African Payment Gateway)
PAYFAST_MERCHANT_ID=25263515
PAYFAST_MERCHANT_KEY=cyxcghcf5hsbl
PAYFAST_PASSPHRASE=
PAYFAST_MODE=production

# Stripe Configuration (Disabled - Using PayFast)
# STRIPE_SECRET_KEY=sk_live_your_live_stripe_key
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
# STRIPE_PUBLISHABLE_KEY=pk_live_your_publishable_key

# Security Configuration
CORS_ORIGIN=https://pdflab.pro
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=/var/log/pdfcraft/app.log

# Monitoring Configuration
SENTRY_DSN=your-sentry-dsn
HEALTH_CHECK_TOKEN=your-health-check-secret

