# Cloud OCR Configuration for pdflab.pro
# Copy this to .env.production for production use or .env.development for development

# ========================================
# GOOGLE VISION API CONFIGURATION
# ========================================
GOOGLE_CLOUD_PROJECT_ID=your-google-project-id
GOOGLE_CLOUD_KEY_FILE=/path/to/service-account-key.json
# OR use API key instead of service account (not recommended for production)
# GOOGLE_CLOUD_API_KEY=your-api-key

# Google Vision API Limits and Settings
GOOGLE_VISION_RPM=300                    # Requests per minute limit
GOOGLE_VISION_TIMEOUT=30000              # Request timeout in milliseconds
GOOGLE_VISION_RETRIES=3                  # Number of retry attempts on failure
GOOGLE_VISION_COST=0.0015               # Cost per request in USD
DISABLE_GOOGLE_VISION=false              # Set to true to disable Google Vision

# ========================================
# AWS TEXTRACT CONFIGURATION
# ========================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# AWS Textract Limits and Settings
AWS_TEXTRACT_RPM=100                     # Requests per minute limit
AWS_TEXTRACT_TIMEOUT=30000               # Request timeout in milliseconds
AWS_TEXTRACT_RETRIES=3                   # Number of retry attempts on failure
AWS_TEXTRACT_COST=0.0015                # Cost per request in USD (base rate)
DISABLE_AWS_TEXTRACT=false               # Set to true to disable AWS Textract

# ========================================
# AZURE COGNITIVE SERVICES (Future Implementation)
# ========================================
AZURE_COGNITIVE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_COGNITIVE_KEY=your-subscription-key
AZURE_COGNITIVE_REGION=your-region

# Azure Cognitive Services Limits and Settings
AZURE_COGNITIVE_RPM=200                  # Requests per minute limit
AZURE_COGNITIVE_TIMEOUT=30000            # Request timeout in milliseconds
AZURE_COGNITIVE_RETRIES=3                # Number of retry attempts on failure
AZURE_COGNITIVE_COST=0.002              # Cost per request in USD
DISABLE_AZURE_COGNITIVE=true             # Currently not implemented, keep disabled

# ========================================
# GENERAL OCR SETTINGS
# ========================================
ENABLE_OCR_COST_TRACKING=true            # Track OCR usage costs
OCR_MONTHLY_BUDGET=100.00               # Monthly budget limit in USD
OCR_COST_TRACKING_PATH=./data/ocr-costs.json  # Path to cost tracking file
ENABLE_OCR_FALLBACK=true                 # Enable engine fallback chain
PREFERRED_OCR_ENGINE=auto                # auto | google-vision | aws-textract | tesseract
ENABLE_OCR_USAGE_LOGGING=true            # Log OCR usage statistics

# ========================================
# DEVELOPMENT/TESTING SETTINGS
# ========================================
# For development, you might want to use mock implementations
OCR_USE_MOCK_APIS=false                  # Use mock APIs for testing (development only)
OCR_DEBUG_MODE=false                     # Enable debug logging for OCR operations
OCR_SAVE_DEBUG_IMAGES=false              # Save processed images for debugging

# ========================================
# RATE LIMITING AND PERFORMANCE
# ========================================
OCR_CONCURRENT_REQUESTS=5                # Max concurrent OCR requests
OCR_QUEUE_SIZE=100                       # Max queue size for OCR requests
OCR_REQUEST_TIMEOUT=60000                # Global request timeout in milliseconds

# ========================================
# SECURITY SETTINGS
# ========================================
OCR_ENCRYPT_RESULTS=false                # Encrypt OCR results at rest
OCR_AUTO_DELETE_IMAGES=true              # Auto-delete uploaded images after processing
OCR_IMAGE_RETENTION_HOURS=1              # Hours to keep images before deletion

# ========================================
# MONITORING AND ALERTS
# ========================================
OCR_ENABLE_MONITORING=true               # Enable performance monitoring
OCR_COST_ALERT_THRESHOLD=80.00          # Alert when monthly costs exceed this amount
OCR_PERFORMANCE_ALERT_TIME=10000        # Alert when processing time exceeds this (ms)
OCR_ERROR_RATE_THRESHOLD=0.05           # Alert when error rate exceeds this percentage

# ========================================
# INTEGRATION SETTINGS
# ========================================
# Webhook URLs for notifications (optional)
OCR_WEBHOOK_URL_SUCCESS=                 # Webhook for successful OCR operations
OCR_WEBHOOK_URL_ERROR=                   # Webhook for OCR errors
OCR_WEBHOOK_URL_BUDGET=                  # Webhook for budget alerts

# Email notifications (optional)
OCR_EMAIL_NOTIFICATIONS=false            # Enable email notifications
OCR_ADMIN_EMAIL=admin@pdflab.pro      # Admin email for notifications
OCR_SMTP_HOST=                          # SMTP host for email notifications
OCR_SMTP_PORT=587                       # SMTP port
OCR_SMTP_USER=                          # SMTP username
OCR_SMTP_PASS=                          # SMTP password

# ========================================
# PRODUCTION OPTIMIZATION
# ========================================
# These settings optimize performance for production use
OCR_ENABLE_CACHING=true                  # Enable result caching
OCR_CACHE_DURATION=3600                  # Cache duration in seconds
OCR_COMPRESS_IMAGES=true                 # Compress images before sending to APIs
OCR_MAX_IMAGE_SIZE=10485760             # Max image size in bytes (10MB)
OCR_RESIZE_LARGE_IMAGES=true            # Auto-resize large images

# ========================================
# BUSINESS LOGIC SETTINGS
# ========================================
OCR_FREE_TIER_LIMIT=10                  # OCR operations per day for free users
OCR_STARTER_TIER_LIMIT=100              # OCR operations per month for starter tier
OCR_PRO_TIER_UNLIMITED=true             # Unlimited operations for pro tier
OCR_ENTERPRISE_TIER_CUSTOM=true         # Custom limits for enterprise tier

# Quality thresholds
OCR_MIN_CONFIDENCE_THRESHOLD=0.7        # Minimum confidence to accept results
OCR_FALLBACK_CONFIDENCE_THRESHOLD=0.5   # Confidence threshold to trigger fallback
OCR_QUALITY_SCORE_THRESHOLD=0.8         # Quality score threshold for premium results

# ========================================
# DEVELOPMENT NOTES
# ========================================
# 1. For Google Vision, create a service account and download the JSON key file
# 2. For AWS Textract, create an IAM user with textract permissions
# 3. Store credentials securely - never commit them to version control
# 4. Use environment-specific files (.env.development, .env.production)
# 5. Test connectivity with the /api/ocr/enhanced/status endpoint
# 6. Monitor costs regularly using the cost tracking features
# 7. Set up alerts for budget overruns and performance issues

# ========================================
# QUICK START INSTRUCTIONS
# ========================================
# 1. Copy this file to .env.production (or .env.development)
# 2. Fill in your cloud service credentials
# 3. Set ENABLE_OCR_COST_TRACKING=true
# 4. Set a reasonable OCR_MONTHLY_BUDGET
# 5. Test with /api/ocr/enhanced/status endpoint
# 6. Start with PREFERRED_OCR_ENGINE=auto for optimal selection
# 7. Monitor usage through the enhanced OCR endpoints