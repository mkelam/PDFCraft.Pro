# ================================
# PDFCRAFT.PRO PRODUCTION ENVIRONMENT
# ================================
# Created: 2025-10-23
# Purpose: Production deployment configuration template
# Instructions: Copy to .env.production and fill in actual values

# ================================
# SERVER CONFIGURATION
# ================================
PORT=3010
NODE_ENV=production
API_URL=https://api.pdfcraft.pro
FRONTEND_URL=https://pdfcraft.pro

# CORS Configuration
CORS_ORIGINS=https://pdfcraft.pro,https://www.pdfcraft.pro

# ================================
# DATABASE CONFIGURATION (Hostinger MySQL)
# ================================
# Get these from Hostinger MySQL Database panel
DB_HOST=your-hostinger-mysql-host.com
DB_PORT=3306
DB_NAME=u123456789_pdfcraft
DB_USER=u123456789_pdfcraft_user
DB_PASSWORD=YOUR_SECURE_DB_PASSWORD_HERE

# Connection Pool Settings
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0

# ================================
# REDIS CONFIGURATION
# ================================
# Redis server for job queue and caching
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=YOUR_SECURE_REDIS_PASSWORD_HERE

# Redis Connection Settings
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY=3000

# ================================
# AUTHENTICATION & SECURITY
# ================================
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=GENERATE_A_SECURE_64_CHAR_SECRET_KEY_HERE
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Session Configuration
SESSION_SECRET=GENERATE_ANOTHER_SECURE_64_CHAR_SECRET_HERE
SESSION_MAX_AGE=604800000

# Password Hashing
BCRYPT_ROUNDS=12

# ================================
# PAYMENT INTEGRATION - PAYFAST (Primary)
# ================================
# Get from: https://www.payfast.co.za/integration/dashboard
PAYFAST_MERCHANT_ID=your_merchant_id
PAYFAST_MERCHANT_KEY=your_merchant_key
PAYFAST_PASSPHRASE=your_secure_passphrase
PAYFAST_MODE=production
PAYFAST_RETURN_URL=https://pdfcraft.pro/payment/success
PAYFAST_CANCEL_URL=https://pdfcraft.pro/payment/cancel
PAYFAST_NOTIFY_URL=https://api.pdfcraft.pro/api/payfast/webhook

# ================================
# PAYMENT INTEGRATION - STRIPE (Backup)
# ================================
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_YOUR_STRIPE_LIVE_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_STRIPE_LIVE_PUBLISHABLE_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# Stripe Product IDs
STRIPE_PRICE_STARTER=price_YOUR_STARTER_PLAN_ID
STRIPE_PRICE_PRO=price_YOUR_PRO_PLAN_ID

# ================================
# EMAIL CONFIGURATION (Hostinger SMTP)
# ================================
# Get from Hostinger Email panel
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@pdfcraft.pro
SMTP_PASS=YOUR_EMAIL_PASSWORD_HERE
EMAIL_FROM=PDFCraft.Pro <noreply@pdfcraft.pro>
EMAIL_REPLY_TO=support@pdfcraft.pro

# Email Templates
EMAIL_VERIFICATION_ENABLED=true
EMAIL_PASSWORD_RESET_ENABLED=true
EMAIL_CONVERSION_COMPLETE_ENABLED=true

# ================================
# FILE UPLOAD & PROCESSING
# ================================
# File Size Limits (bytes)
MAX_FILE_SIZE=104857600
MAX_FILE_SIZE_FREE=10485760
MAX_FILE_SIZE_STARTER=26214400
MAX_FILE_SIZE_PRO=104857600

# Storage Paths (VPS)
UPLOAD_DIR=/var/www/pdfcraft/uploads
TEMP_DIR=/var/www/pdfcraft/temp
OUTPUT_DIR=/var/www/pdfcraft/output
LOG_DIR=/var/www/pdfcraft/logs

# File Cleanup
FILE_RETENTION_HOURS=1
CLEANUP_INTERVAL_MINUTES=15

# ================================
# PDF PROCESSING CONFIGURATION
# ================================
# LibreOffice Path (Ubuntu/Debian VPS)
LIBREOFFICE_PATH=/usr/bin/libreoffice
LIBREOFFICE_TIMEOUT=30000

# Tesseract OCR
TESSERACT_PATH=/usr/bin/tesseract
TESSERACT_LANG=eng
OCR_ENABLED=true
OCR_CONFIDENCE_THRESHOLD=75

# ImageMagick
IMAGEMAGICK_PATH=/usr/bin/convert
IMAGE_QUALITY=95
IMAGE_DPI=300

# Processing Workers
WORKER_CONCURRENCY=2
MAX_CONCURRENT_CONVERSIONS=5

# ================================
# CLOUDCONVERT (Optional Fallback)
# ================================
# Get from: https://cloudconvert.com/dashboard/api/v2/keys
CLOUDCONVERT_API_KEY=your_cloudconvert_api_key_here
CLOUDCONVERT_SANDBOX=false
CLOUDCONVERT_ENABLED=false

# ================================
# RATE LIMITING & THROTTLING
# ================================
# General API Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Conversion Rate Limits by Tier
RATE_LIMIT_FREE_PER_DAY=3
RATE_LIMIT_STARTER_PER_MONTH=100
RATE_LIMIT_PRO_UNLIMITED=true

# CPU Throttling
CPU_THROTTLE_THRESHOLD=85
CPU_CRITICAL_THRESHOLD=95

# ================================
# MONITORING & LOGGING
# ================================
# Logging Level
LOG_LEVEL=info
LOG_FORMAT=json

# Error Tracking (Sentry - Optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_ENABLED=false

# Performance Monitoring
ENABLE_PERFORMANCE_MONITORING=true
ENABLE_QUALITY_MONITORING=true
ENABLE_COST_MONITORING=true

# ================================
# FEATURE FLAGS
# ================================
ENABLE_PDF_MERGE=true
ENABLE_PDF_TO_PPT=true
ENABLE_OCR=true
ENABLE_ANALYTICS=true
ENABLE_USER_REGISTRATION=true
ENABLE_PAYMENT=true
ENABLE_EMAIL_NOTIFICATIONS=true

# Beta Features
ENABLE_PDF_TO_EXCEL=false
ENABLE_PDF_TO_WORD=false
ENABLE_BATCH_PROCESSING=false

# ================================
# SECURITY HEADERS & CORS
# ================================
HELMET_ENABLED=true
CORS_ENABLED=true
COMPRESSION_ENABLED=true

# Content Security Policy
CSP_ENABLED=true

# ================================
# SSL/TLS CONFIGURATION
# ================================
SSL_ENABLED=true
FORCE_HTTPS=true

# ================================
# ANALYTICS & TRACKING
# ================================
GOOGLE_ANALYTICS_ID=
MIXPANEL_TOKEN=

# ================================
# BACKUP & DISASTER RECOVERY
# ================================
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=7
BACKUP_DIR=/var/backups/pdfcraft

# ================================
# HEALTH CHECK & ALERTS
# ================================
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=60000

# Alert Thresholds
ALERT_CPU_THRESHOLD=90
ALERT_MEMORY_THRESHOLD=85
ALERT_DISK_THRESHOLD=80
ALERT_ERROR_RATE_THRESHOLD=5

# ================================
# ENVIRONMENT INFO
# ================================
APP_NAME=PDFCraft.Pro
APP_VERSION=1.0.0
DEPLOYMENT_DATE=2025-10-23
DEPLOYED_BY=Production Team
