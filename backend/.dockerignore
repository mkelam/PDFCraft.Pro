# ============================================
# Backend .dockerignore
# Optimized for multi-stage builds
# ============================================

# Dependencies (reinstalled in container)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json.bak

# Testing
coverage/
.nyc_output/
*.test.ts
*.test.js
*.spec.ts
*.spec.js
test/
tests/
__tests__/
jest.config.*
*.mock.ts

# Production build (created in container)
dist/
build/
*.tsbuildinfo

# Environment files (passed as env vars)
.env*
!.env.example

# Logs (created at runtime)
logs/
*.log
npm-debug.log*
lerna-debug.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Uploads and temp files (created at runtime)
uploads/
temp/
data/
*.pdf
*.pptx
*.docx
*.xlsx
*.zip

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~
.editorconfig

# OS files
.DS_Store
.DS_Store?
._*
Thumbs.db
Desktop.ini
*.tmp

# Git
.git/
.gitignore
.gitattributes
.github/

# Docker (avoid recursion)
Dockerfile*
docker-compose*.yml
.dockerignore
*.dockerfile

# Documentation
README.md
CHANGELOG.md
CONTRIBUTING.md
LICENSE
docs/
*.md
!package.json

# CI/CD
.travis.yml
.gitlab-ci.yml
.circleci/
.github/workflows/

# Development scripts
scripts/deploy*.sh
scripts/setup*.sh
scripts/validate*.sh
*.bat

# Database files
*.db
*.sqlite
*.sqlite3
migrations/

# Misc
*.pem
*.key
*.cert
*.crt
ssl/
secrets/
