# PDFCraft.Pro Docker Environment Variables
# Docker Development Configuration

# ===== SECURITY ======
# JWT secret for authentication
JWT_SECRET=docker-dev-secret-key-change-in-production-min-32-chars-required

# ===== EMAIL CONFIGURATION =====
# Hostinger SMTP Settings
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=noreply@pdflab.pro
SMTP_PASSWORD=your-email-password-here
SMTP_FROM=PDFLab.Pro <noreply@pdflab.pro>

# ===== URLS =====
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001

# ===== MYSQL DATABASE (Docker) =====
MYSQL_ROOT_PASSWORD=your-root-password-here
MYSQL_PASSWORD=your-db-password-here
DATABASE_URL=mysql://pdfcraft_user:your-db-password-here@mysql:3306/pdfcraft_db

# ===== REDIS =====
REDIS_URL=redis://redis:6379

