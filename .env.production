# PDFCraft.Pro Production Environment Variables
# Copy this file to .env and fill in your actual values

# Database Configuration
MYSQL_ROOT_PASSWORD=your_strong_root_password_here
MYSQL_PASSWORD=your_strong_db_password_here

# Application Security
JWT_SECRET=your_super_secure_jwt_secret_here_min_64_chars_recommended
JWT_REFRESH_SECRET=your_super_secure_refresh_secret_here

# Paystack Configuration
PAYSTACK_SECRET_KEY=sk_live_your_paystack_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_live_your_paystack_public_key_here

# Application Configuration
NODE_ENV=production
APP_URL=https://pdfcraft.pro
FRONTEND_URL=https://pdfcraft.pro
NEXT_PUBLIC_API_URL=http://localhost:3001

# File Processing
MAX_FILE_SIZE=104857600
UPLOAD_DIR=/app/uploads
TEMP_DIR=/app/temp

# External Services
LIBREOFFICE_AVAILABLE=true
GHOSTSCRIPT_AVAILABLE=true
IMAGEMAGICK_AVAILABLE=true

# Email Configuration (Optional)
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_USER=your_email@domain.com
SMTP_PASS=your_email_password

# Monitoring & Analytics (Optional)
SENTRY_DSN=your_sentry_dsn_for_error_tracking